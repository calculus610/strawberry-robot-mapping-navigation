# Copy this file to .robot.env, then set ROBOT_HOST to the robot IP address.
# .robot.env is intentionally ignored by Git.

ROBOT_HOST=""
ROBOT_USER="wheeltec"
ROBOT_PORT="22"
ROBOT_WORKSPACE="/home/wheeltec/zzj_ws"
ROBOT_ROS_SETUP="/opt/ros/humble/setup.bash"
ROBOT_IDENTITY_FILE="${HOME}/.ssh/wheeltec_robot_ed25519"

# This runs on the Ubuntu robot, never on the Mac.
ROBOT_BUILD_COMMAND="colcon build --symlink-install"

# Keep this disabled until the first several syncs have been checked carefully.
# When enabled, files absent on the Mac are deleted from the robot workspace.
ROBOT_SYNC_DELETE="0"
