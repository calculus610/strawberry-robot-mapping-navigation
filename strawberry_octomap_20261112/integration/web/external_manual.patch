+    def _strawberry_node_processes(self, launch, children, names):
+        if any(names[name] != 1 for name in STRAWBERRY_EXECUTABLES):
+            return []
+        output = Path(launch.argv[6].removeprefix('output_dir:='))
+        python = PYTHON_EXECUTABLE.resolve(strict=True)
+        install = STRAWBERRY_ROOT / 'ws/install'
+        expected = {name: (install / file).resolve(strict=True)
+                    for name, file in STRAWBERRY_EXECUTABLES.items()}
+        if any(not path.is_relative_to(install) for path in expected.values()):
+            return []
+        required = (STRAWBERRY_TOKEN + output.name.encode(),
+                    f'ROS_DOMAIN_ID={os.environ.get("ROS_DOMAIN_ID", "0")}'.encode(),
+                    b'ROS_LOCALHOST_ONLY=1')
+        if not self._strawberry_environment(launch, required):
+            return []
+        matches = defaultdict(list)
+        # This launch starts every required node directly, without process prefixes.
+        for child in children.get(launch.path.name, ()):
+            if not child.argv or child.started < launch.started:
+                continue
+            try:
+                exe = (child.path / 'exe').resolve(strict=True)
+                if (child.path / 'cwd').resolve(strict=True) != output:
+                    continue
+                for name, target in expected.items():
+                    if target.suffix == '.py':
