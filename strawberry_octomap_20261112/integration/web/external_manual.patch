+                    if (matched and f'__node:={node_name}' in child.argv
+                            and f'__ns:={namespace}' in child.argv
+                            and self._strawberry_environment(child, required)):
+                        matches[name].append(child)
+            except PROCESS_ERRORS:
+                continue
+        return [matches[name][0] for name in expected] if all(len(matches[name]) == 1 for name in expected) else []
+
+    def _strawberry_environment(self, process, required):
